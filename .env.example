# Product configuration
APP_TIME_ZONE=Europe/Moscow

# Use "development" for the isolated local repository or "supabase" for the
# real PostgreSQL/Auth path.
DATA_BACKEND=development
DEV_DATA_FILE=.data/dev-db.json

# Required for the local admin login when DATA_BACKEND=development.
DEV_ADMIN_PASSWORD=change-this-local-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Required when DATA_BACKEND=supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
